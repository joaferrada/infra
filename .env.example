# Copiar a .env (no se versiona) y completar. Lo lee infra/compose.yml.

# --- RabbitMQ (cluster rabbit1 + rabbit2) ---
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# Misma cookie en ambos nodos; usar una larga y aleatoria
RABBITMQ_ERLANG_COOKIE=cambia-esta-cookie-por-una-larga-y-aleatoria

# --- Oracle Autonomous Database ---
# Carpeta del wallet en el host (se monta en /wallet como solo lectura)
WALLET_DIR=C:/oracle/wallet_andesstay
# Usuario ANDESSTAY
RESERVATIONS_DB_PASSWORD=
# Usuario ANDESSTAY_CATALOG
CATALOG_DB_PASSWORD=
# Usuario ANDESSTAY_AUDIT
AUDIT_DB_PASSWORD=

# --- Microservicios ---
# false deja /api/admin/** de rabbitadmin sin autenticacion (solo pruebas locales)
RABBITADMIN_SECURITY_ENABLED=true
# Opciones de la JVM para todos los servicios (cada contenedor tiene mem_limit 512m)
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
ANDESSTAY_DLQ_RETENTION=7d
NOTIFY_PREFETCH=5
NOTIFY_MAX_ATTEMPTS=3
NOTIFY_RETRY_BACKOFF=1s
NOTIFY_SIMULATION_ENABLED=true
NOTIFY_DLQ_LISTENER=false
